---
import Base from "../../../layouts/Base.astro";
import Icon from "../../../components/Icon.astro";
import CaseSummary from "../../../components/CaseSummary.astro";
import SensitivityTable from "../../../components/SensitivityTable.astro";
import { LANGS, type Lang, text, labelled, pipes, numbered, clauses, items } from "../../../lib/content";
import { ui } from "../../../lib/ui";

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const t = ui(lang);

const tags = pipes(text("case3", "tagline", lang));
// last tag is "Group coursework, UEH, 03/2025. My role: team lead"
const last = tags.pop()!.split(". ");
const chips = [...tags, ...last];
const headline = text("case3", "headline", lang);
const nextName = pipes(text("case2", "tagline", lang))[1];
const approach = numbered(text("case3", "approach", lang));
const stats = items("case3", "key_figures", lang);
const role = labelled("case3", "role", lang);
const lessons = labelled("case3", "lessons", lang);
---
<Base lang={lang} title={`${tags[1]} – ${t.name}`} description={headline}>
  <section class="section--white">
    <div class="wrap stack intro">
      <nav aria-label={t.breadcrumb} class="crumbs">
        <a href={`/${lang}/#projects`}>{t.nav.projects}</a><span aria-hidden="true">/</span><span>{tags[1]}</span>
      </nav>
      <ul class="chips">{chips.map((c, i) => <li class={i === 0 ? "chip chip--key" : "chip"}>{c}</li>)}</ul>
      <h1 class="h1" style="max-width:920px;font-size:clamp(30px,4.4vw,50px)">{headline}</h1>
      <CaseSummary lang={lang} block="case3" />
    </div>
  </section>

  <section aria-label={t.keyFigures} class="section--white figures">
    <div class="wrap grid grid--stats">
      {stats.map((s, i) => (
        <div class={i === 0 ? "stat stat--solid" : "stat"}>
          <div class="stat__value num">{s.value}</div>
          <div class="stat__label">{s.label}</div>
        </div>
      ))}
    </div>
  </section>

  <section aria-labelledby="approach-h" class="section">
    <div class="wrap stack">
      <h2 id="approach-h" class="h2">{text("case3", "approach_headline", lang)}</h2>
      <ol class="grid approach">
        {approach.map((a, i) => (
          <li class="card" style="padding:24px;gap:10px">
            <span class="approach__n num">{String(i + 1).padStart(2, "0")}</span>
            <p class="prose">{a}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section aria-labelledby="sens-h" class="section section--white section--rule">
    <div class="wrap stack">
      <div class="eyebrow">{t.sensitivity}</div>
      <h2 id="sens-h" class="h2">{text("case3", "sensitivity_headline", lang)}</h2>
      <figure class="chart">
        <img src={`/images/case3-sensitivity-heatmap-${lang}.png`} width="1600" height="900" loading="lazy"
          alt={t.sensCaption} />
        <details>
          <summary>{t.showNumbers}</summary>
          <SensitivityTable lang={lang} />
        </details>
      </figure>
    </div>
  </section>

  <section class="section section--rule">
    <div class="wrap grid">
      <div class="card">
        <h2 class="h3" style="font-size:24px">{role.label}</h2>
        <p class="prose">{role.body.charAt(0).toUpperCase() + role.body.slice(1)}</p>
      </div>
      <div class="card">
        <h2 class="h3" style="font-size:24px">{lessons.label}</h2>
        <ul class="lessons">{clauses(lessons.body).map((l) => <li>{l}</li>)}</ul>
      </div>
    </div>
  </section>

  <nav class="section--white section--rule" aria-label={t.next}>
    <div class="wrap pager">
      <a class="link-arrow" href={`/${lang}/#projects`}><Icon name="arrow-left" size={16} />{t.allProjects}</a>
      <a class="link-arrow" href={`/${lang}/cases/riverside-residences/`}>{t.next}: {nextName}<Icon name="arrow-right" size={16} /></a>
    </div>
  </nav>
</Base>

<style>
  .intro { padding-block: 40px 56px; gap: 20px; }
  .crumbs { font-size: 14px; color: var(--text-muted); display: flex; gap: 8px; flex-wrap: wrap; }
  .crumbs a { text-decoration: none; }
  .lead strong { color: var(--text); }
  .figures { border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); padding-block: 32px; }
  .approach { list-style: none; margin: 0; padding: 0; }
  .approach__n { font-family: var(--font-head); font-size: 28px; font-weight: 700; color: var(--accent-text); }
  .chart { margin: 0; display: flex; flex-direction: column; gap: 16px; }
  .chart img { width: 100%; max-width: 960px; border: 1px solid var(--border); border-radius: 8px; }
  .lessons { margin: 0; padding-left: 20px; color: var(--text-2); display: flex; flex-direction: column; gap: 8px; }
  .pager { padding-block: 32px; display: flex; flex-wrap: wrap; gap: 16px; justify-content: space-between; }
</style>
