---
import Base from "../../../layouts/Base.astro";
import Icon from "../../../components/Icon.astro";
import CaseSummary from "../../../components/CaseSummary.astro";
import figures from "../../../data/figures.json";
import { LANGS, type Lang, text, labelled, pipes, numbered, clauses, items } from "../../../lib/content";
import { ui, num } from "../../../lib/ui";

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const t = ui(lang);

const tags = pipes(text("case2", "tagline", lang));
const chips = [...tags.slice(0, -1), ...tags.at(-1)!.split(". ")];
const headline = text("case2", "headline", lang);
const approach = numbered(text("case2", "approach", lang));
const stats = items("case2", "key_figures", lang);
const sens = labelled("case2", "sensitivity", lang);
const role = labelled("case2", "role", lang);
const lessons = labelled("case2", "lessons", lang);
const nextName = pipes(text("case4", "tagline", lang))[0].replace(/\s*\(.*\)$/, "");

// IRR grid from figures.csv: construction cost factor (rows) × sale price change (columns)
const F = Object.fromEntries(figures.filter((f) => f.case === "case2").map((f) => [f.key, f.value]));
const facs = [90, 95, 100, 105, 110];
const ps = [-10, -5, 0, 5, 10];
const sign = (x: number) => (x > 0 ? `+${x}%` : x < 0 ? `${x}%` : "0");
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
---
<Base lang={lang} title={`${tags[1]} – ${t.name}`} description={headline}>
  <section class="section--white">
    <div class="wrap stack intro">
      <nav aria-label={t.breadcrumb} class="crumbs">
        <a href={`/${lang}/#projects`}>{t.nav.projects}</a><span aria-hidden="true">/</span><span>{tags[1]}</span>
      </nav>
      <ul class="chips">{chips.map((c, i) => <li class={i === 0 ? "chip chip--key" : "chip"}>{c}</li>)}</ul>
      <h1 class="h1" style="max-width:920px;font-size:clamp(30px,4.4vw,50px)">{headline}</h1>
      <CaseSummary lang={lang} block="case2" excel={false} />
    </div>
  </section>

  <section aria-label={t.keyFigures} class="section--white figures">
    <div class="wrap grid grid--stats">
      {stats.map((s, i) => (
        <div class={i === 0 ? "stat stat--solid" : "stat"}>
          <div class="stat__value num">{s.value}</div>
          <div class="stat__label">{s.label}</div>
        </div>
      ))}
    </div>
  </section>

  <section aria-labelledby="approach-h" class="section">
    <div class="wrap stack">
      <div class="eyebrow">{t.approach}</div>
      <h2 id="approach-h" class="h2">{t.modelMap}</h2>
      <ol class="grid approach">
        {approach.map((a, i) => (
          <li class="card" style="padding:24px;gap:10px">
            <span class="approach__n num">{String(i + 1).padStart(2, "0")}</span>
            <p class="prose">{a}</p>
          </li>
        ))}
      </ol>
      <figure class="chart">
        <img src={`/images/case2-model-map-${lang}.png`} width="1600" height="900" loading="lazy" alt={approach[0]} />
        <figcaption class="note-small">{t.noExcel}</figcaption>
      </figure>
    </div>
  </section>

  <section aria-labelledby="fund-h" class="section section--white section--rule">
    <div class="wrap stack">
      <div class="eyebrow">{t.funding}</div>
      <h2 id="fund-h" class="h2">{text("case2", "funding_headline", lang)}</h2>
      <figure class="chart">
        <img src={`/images/case2-funding-and-sensitivity-${lang}.png`} width="1600" height="900" loading="lazy" alt={`${text("case2", "funding_headline", lang)}. ${sens.body}`} />
        <p class="prose"><strong>{sens.label}:</strong> {sens.body}</p>
        <details>
          <summary>{t.showNumbers}</summary>
          <div class="table-box">
            <table class="data">
              <caption class="cap">{lang === "vi" ? "IRR dự án (TIPV). Hàng: chi phí xây dựng so với cơ sở; cột: giá bán căn hộ so với cơ sở." : "Project IRR (TIPV). Rows: construction cost vs base; columns: apartment sale price vs base."}</caption>
              <thead><tr><th scope="col"></th>{ps.map((p) => <th scope="col">{sign(p)}</th>)}</tr></thead>
              <tbody>
                {facs.map((f) => (
                  <tr>
                    <th scope="row">{sign(f - 100)}</th>
                    {ps.map((p) => <td class={f === 100 && p === 0 ? "base" : undefined}>{num(Number(F[`irr_c${f}_p${p}`]), lang, 1)}%</td>)}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
      </figure>
    </div>
  </section>

  <section class="section section--rule">
    <div class="wrap grid">
      <div class="card">
        <h2 class="h3" style="font-size:24px">{role.label}</h2>
        <p class="prose">{cap(role.body)}</p>
      </div>
      <div class="card">
        <h2 class="h3" style="font-size:24px">{lessons.label}</h2>
        <ul class="lessons">{clauses(lessons.body).map((l) => <li>{l}</li>)}</ul>
      </div>
    </div>
  </section>

  <nav class="section--white section--rule" aria-label={t.next}>
    <div class="wrap pager">
      <a class="link-arrow" href={`/${lang}/cases/grade-b-office/`}><Icon name="arrow-left" size={16} />{pipes(text("case3", "tagline", lang))[1]}</a>
      <a class="link-arrow" href={`/${lang}/cases/acquisition-checklist/`}>{t.next}: {nextName}<Icon name="arrow-right" size={16} /></a>
    </div>
  </nav>
</Base>

<style>
  .intro { padding-block: 40px 56px; gap: 20px; }
  .crumbs { font-size: 14px; color: var(--text-muted); display: flex; gap: 8px; flex-wrap: wrap; }
  .crumbs a { text-decoration: none; }
  .figures { border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); padding-block: 32px; }
  .approach { list-style: none; margin: 0; padding: 0; }
  .approach__n { font-family: var(--font-head); font-size: 28px; font-weight: 700; color: var(--accent-text); }
  .chart { margin: 0; display: flex; flex-direction: column; gap: 16px; }
  .chart img { width: 100%; max-width: 1040px; border: 1px solid var(--border); border-radius: 8px; }
  .note-small { font-size: 14px; color: var(--text-muted); }
  .cap { caption-side: bottom; text-align: left; font-size: 14px; color: var(--text-muted); padding-top: 8px; }
  .lessons { margin: 0; padding-left: 20px; color: var(--text-2); display: flex; flex-direction: column; gap: 8px; }
  .pager { padding-block: 32px; display: flex; flex-wrap: wrap; gap: 16px; justify-content: space-between; }
</style>
