---
import Base from "../../../layouts/Base.astro";
import Icon from "../../../components/Icon.astro";
import CaseSummary from "../../../components/CaseSummary.astro";
import { LANGS, type Lang, text, labelled, pipes, rich } from "../../../lib/content";
import { ui } from "../../../lib/ui";

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const t = ui(lang);

type Step = { phase: number; title: string; work: string; output: string; who: string; legal: number[] };
type Check = { title: string; review: string; risk: string; basis: string };
type Lens = { role: string; points: string[] };
type Scenario = { scenario: string; irr: string; npv: string; peak: string };

const tags = pipes(text("case4", "tagline", lang));
const headline = text("case4", "headline", lang);
const thesis = labelled("case4", "thesis", lang);
const howTo = labelled("case4", "how_to_read", lang);
const checks = rich<Check>("case4", "steps", lang);
const steps = rich<Step>("case4", "process", lang).map((s, i) => ({ ...s, n: i + 1 }));
const colors = ["var(--primary)", "#3f5f86", "var(--accent-decor)"];
const phases = pipes(text("case4", "phases", lang)).map((name, i) => ({ n: i + 1, name, color: colors[i], steps: steps.filter((s) => s.phase === i + 1) }));
const example = labelled("case4", "example", lang);
const scenarios = rich<Scenario>("case4", "example", lang);
const lenses = rich<Lens>("case4", "lenses", lang);
const lensNote = labelled("case4", "lenses_note", lang);
const prevName = pipes(text("case2", "tagline", lang))[1];

// IRR bars on a 0-24% scale, with the WACC marked
const pct = (s: string) => Number(s.replace("%", "").replace(",", "."));
const SCALE = 24, WACC = 13.87;
const waccLabel = `WACC ${lang === "vi" ? "13,87" : "13.87"}%`;
---
<Base lang={lang} title={`${t.checklist} – ${t.name}`} description={headline}>
  <section class="section--white">
    <div class="wrap stack intro">
      <nav aria-label={t.breadcrumb} class="crumbs">
        <a href={`/${lang}/#projects`}>{t.nav.projects}</a><span aria-hidden="true">/</span><span>{t.checklist}</span>
      </nav>
      <ul class="chips">{tags.map((c, i) => <li class={i === 0 ? "chip chip--key" : "chip"}>{c}</li>)}</ul>
      <h1 class="h1" style="max-width:960px;font-size:clamp(30px,4.2vw,48px)">{headline}</h1>
      <CaseSummary lang={lang} block="case4" />
      <div class="card thesis"><p class="prose"><strong>{thesis.label}:</strong> {thesis.body}</p></div>
    </div>
  </section>

  <section aria-labelledby="process-h" class="section section--rule">
    <div class="wrap stack">
      <h2 id="process-h" class="h2">{t.part1}</h2>
      <p class="prose lead">{howTo.body}</p>
      <div class="strip">
        {phases.map((p) => (
          <div class="strip__phase" style={`--c:${p.color}`}>
            <p class="strip__name">{String(p.n).padStart(2, "0")} · {p.name}</p>
            <ol class="strip__steps">
              {p.steps.map((s) => <li><a href={`#step-${s.n}`}><b class="num">{s.n}</b><span>{s.title}</span>{s.legal.length > 0 && <i>◆ {t.legalTag}</i>}</a></li>)}
            </ol>
          </div>
        ))}
      </div>
      <p class="legend"><span aria-hidden="true">◆</span> {t.legend}</p>

      <div class="road">
        {phases.map((p) => (
          <>
            <div class="road__phase" style={`--c:${p.color}`}><span>{t.phaseWord} {p.n}</span><h3>{p.name}</h3></div>
            {p.steps.map((s) => (
              <>
                <article class="road__step" id={`step-${s.n}`} style={`--c:${p.color}`}>
                  <div class="road__num num">{s.n}</div>
                  <div class="road__body">
                    <h4>{s.title}</h4>
                    <dl>
                      <div><dt>{t.work}</dt><dd>{s.work}</dd></div>
                      <div><dt>{t.output}</dt><dd>{s.output}</dd></div>
                      <div><dt>{t.who}</dt><dd>{s.who}</dd></div>
                    </dl>
                  </div>
                </article>
                {s.legal.map((k) => (
                  <div class="road__check" id={`check-${k}`}>
                    <div class="road__mark" aria-hidden="true">◆</div>
                    <div class="road__checkbody">
                      <p class="road__label">{t.legalCheck} P{k} · {t.atStep} {s.n}</p>
                      <h5>{checks[k - 1].title}</h5>
                      <div class="road__cols">
                        <div><p class="road__h">{t.review}</p><p>{checks[k - 1].review}</p></div>
                        <div class="road__risk"><p class="road__h">{t.risk}</p><p>{checks[k - 1].risk}</p></div>
                      </div>
                      <p class="road__basis">{t.basis}: {checks[k - 1].basis}</p>
                    </div>
                  </div>
                ))}
              </>
            ))}
          </>
        ))}
      </div>
    </div>
  </section>

  <section aria-labelledby="example-h" class="section section--white section--rule">
    <div class="wrap stack">
      <h2 id="example-h" class="h2">{text("case4", "example_headline", lang)}</h2>
      <p class="prose lead">{example.body}</p>
      <p class="bars__title">{t.irrByScenario}</p>
      <div class="bars">
        {scenarios.map((s, i) => (
          <div class="bars__row">
            <span class="bars__label">{s.scenario}</span>
            <div class="bars__track">
              <div class={`bars__fill${i === 0 ? " is-base" : ""}${pct(s.irr) < WACC ? " is-low" : ""}`} style={`width:${(pct(s.irr) / SCALE) * 100}%`}><b class="num">{s.irr}</b></div>
              <div class="bars__wacc" style={`left:${(WACC / SCALE) * 100}%`}>{i === 0 && <span>{waccLabel}</span>}</div>
            </div>
            <span class="bars__note">{t.npvShort} {s.npv} {t.bn} · {t.peakShort} {s.peak} {t.bn}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section aria-labelledby="lenses-h" class="section section--rule">
    <div class="wrap stack">
      <h2 id="lenses-h" class="h2">{text("case4", "lenses_headline", lang)}</h2>
      <div class="note"><Icon name="info" size={22} /><p><strong>{lensNote.label}:</strong> {lensNote.body}</p></div>
      <div class="grid">
        {lenses.map((l) => (
          <div class="card lens">
            <h3 class="h3">{l.role}</h3>
            <ul class="lens__list">{l.points.map((x) => <li>{x}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <nav class="section--white section--rule" aria-label={t.next}>
    <div class="wrap pager">
      <a class="link-arrow" href={`/${lang}/cases/riverside-residences/`}><Icon name="arrow-left" size={16} />{prevName}</a>
      <a class="link-arrow" href={`/${lang}/#projects`}>{t.allProjects}<Icon name="arrow-right" size={16} /></a>
    </div>
  </nav>
</Base>

<style>
  .intro { padding-block: 40px 56px; gap: 20px; }
  .crumbs { font-size: 14px; color: var(--text-muted); display: flex; gap: 8px; flex-wrap: wrap; }
  .crumbs a { text-decoration: none; }
  .thesis { border-left: 4px solid var(--accent-decor); }
  .lead { max-width: 860px; }

  /* overview strip */
  .strip { display: grid; grid-template-columns: 3fr 5fr 2fr; gap: 12px; }
  .strip__phase { background: var(--surface); border: 1px solid var(--border); border-top: 4px solid var(--c); border-radius: var(--radius); padding: 14px; }
  .strip__name { font-size: 12.5px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 12px; }
  .strip__steps { list-style: none; margin: 0; padding: 0; display: flex; gap: 6px; }
  .strip__steps li { flex: 1; }
  .strip__steps a { display: flex; flex-direction: column; align-items: center; gap: 6px; text-align: center; text-decoration: none; color: var(--text); font-size: 13.5px; line-height: 1.3; min-height: 44px; }
  .strip__steps a:hover span { color: var(--primary); text-decoration: underline; }
  .strip__steps b { width: 32px; height: 32px; border-radius: 50%; background: var(--c); color: #fff; display: grid; place-items: center; font-size: 14px; }
  .strip__steps i { font-style: normal; font-size: 11px; font-weight: 700; color: var(--accent-text); }
  .legend { font-size: 14px; color: var(--text-muted); }
  .legend span { color: var(--accent-decor); }

  /* vertical roadmap */
  .road { position: relative; padding-left: 4px; }
  .road::before { content: ""; position: absolute; left: 27px; top: 0; bottom: 0; width: 3px; background: var(--border); }
  .road__phase { margin: 26px 0 12px 64px; border-left: 4px solid var(--c); padding: 2px 0 2px 14px; }
  .road__phase span { font-size: 12.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--c); }
  .road__phase h3 { font-size: 23px; }
  .road__step, .road__check { position: relative; display: flex; gap: 16px; margin: 12px 0; scroll-margin-top: 96px; }
  .road__num { flex: none; width: 48px; height: 48px; border-radius: 50%; background: var(--c); color: #fff; display: grid; place-items: center; font-weight: 700; font-size: 18px; border: 4px solid var(--bg); z-index: 1; }
  .road__body { flex: 1; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 16px 20px; }
  .road__step:target .road__body, .road__check:target .road__checkbody { outline: 3px solid var(--accent-decor); outline-offset: 2px; }
  .road__body h4 { font-family: var(--font-head); font-size: 20px; color: var(--primary); margin: 0 0 8px; }
  .road__body dl { margin: 0; display: grid; grid-template-columns: 2fr 1.3fr 1.2fr; gap: 16px; }
  .road__body dt, .road__h { font-size: 12.5px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--text-muted); margin: 0; }
  .road__body dd { margin: 3px 0 0; font-size: 15px; color: var(--text-2); }
  .road__mark { flex: none; width: 48px; display: grid; place-items: center; color: var(--accent-decor); font-size: 22px; z-index: 1; }
  .road__checkbody { flex: 1; margin-left: 24px; background: #fffbf2; border: 1px solid #ebd7ae; border-left: 4px solid var(--accent-decor); border-radius: var(--radius); padding: 16px 20px; }
  .road__label { font-size: 12.5px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: var(--accent-text); }
  .road__checkbody h5 { font-family: var(--font-head); font-size: 19px; color: var(--primary); margin: 2px 0 10px; }
  .road__cols { display: grid; grid-template-columns: 1.4fr 1fr; gap: 16px; }
  .road__cols p:last-child { margin: 3px 0 0; font-size: 15px; color: var(--text-2); }
  .road__risk { background: #fbf1e6; border-radius: 8px; padding: 10px 12px; }
  .road__risk p:last-child { color: #7a3e10; }
  .road__basis { margin-top: 10px; font-size: 13.5px; color: var(--text-muted); }

  /* IRR bars */
  .bars__title { font-size: 13px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: var(--text-muted); margin-top: 6px; }
  .bars { display: flex; flex-direction: column; gap: 14px; padding-top: 18px; }
  .bars__row { display: grid; grid-template-columns: 150px 1fr 300px; gap: 16px; align-items: center; }
  .bars__label { font-weight: 600; }
  .bars__track { position: relative; height: 40px; background: var(--bg); border-radius: 6px; }
  .bars__fill { height: 100%; border-radius: 6px; background: #3f5f86; color: #fff; display: flex; align-items: center; justify-content: flex-end; padding-right: 10px; }
  .bars__fill.is-base { background: var(--primary); }
  .bars__fill.is-low { background: #9b2c2c; }
  .bars__wacc { position: absolute; top: -6px; bottom: -6px; border-left: 2px dashed var(--accent-decor); }
  .bars__wacc span { position: absolute; top: -22px; left: 6px; font-size: 12.5px; font-weight: 600; color: var(--accent-text); white-space: nowrap; }
  .bars__note { font-size: 14px; color: var(--text-muted); }

  .lens__list { margin: 0; padding-left: 18px; display: flex; flex-direction: column; gap: 8px; color: var(--text-2); }
  .lens__list li::marker { color: var(--accent-text); }
  .pager { padding-block: 32px; display: flex; flex-wrap: wrap; gap: 16px; justify-content: space-between; }

  @media (max-width: 900px) {
    .strip, .road__cols, .road__body dl { grid-template-columns: 1fr; }
    .strip__steps { flex-direction: column; }
    .strip__steps a { flex-direction: row; text-align: left; }
    .road__phase { margin-left: 56px; }
    .road__checkbody { margin-left: 0; }
    .bars__row { grid-template-columns: 1fr; gap: 6px; }
  }
</style>
