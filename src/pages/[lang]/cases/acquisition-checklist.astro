---
import Base from "../../../layouts/Base.astro";
import Icon from "../../../components/Icon.astro";
import CaseSummary from "../../../components/CaseSummary.astro";
import { LANGS, type Lang, text, labelled, pipes, rich } from "../../../lib/content";
import { ui } from "../../../lib/ui";

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const t = ui(lang);

type Step = { phase: number; title: string; review: string; risk: string; basis: string };
type Lens = { role: string; points: string[] };
type Scenario = { scenario: string; irr: string; npv: string; peak: string };

const tags = pipes(text("case4", "tagline", lang));
const headline = text("case4", "headline", lang);
const thesis = labelled("case4", "thesis", lang);
const howTo = labelled("case4", "how_to_read", lang);
const phaseNames = pipes(text("case4", "phases", lang));
const steps = rich<Step>("case4", "steps", lang).map((s, i) => ({ ...s, n: i + 1 }));
const phases = phaseNames.map((name, i) => ({ n: i + 1, name, steps: steps.filter((s) => s.phase === i + 1) }));
const lenses = rich<Lens>("case4", "lenses", lang);
const example = labelled("case4", "example", lang);
const scenarios = rich<Scenario>("case4", "example", lang);
const lensNote = labelled("case4", "lenses_note", lang);
const prevName = pipes(text("case2", "tagline", lang))[1];
---
<Base lang={lang} title={`${t.checklist} – ${t.name}`} description={headline}>
  <section class="section--white">
    <div class="wrap stack intro">
      <nav aria-label={t.breadcrumb} class="crumbs">
        <a href={`/${lang}/#projects`}>{t.nav.projects}</a><span aria-hidden="true">/</span><span>{t.checklist}</span>
      </nav>
      <ul class="chips">{tags.map((c, i) => <li class={i === 0 ? "chip chip--key" : "chip"}>{c}</li>)}</ul>
      <h1 class="h1" style="max-width:920px;font-size:clamp(30px,4.4vw,50px)">{headline}</h1>
      <CaseSummary lang={lang} block="case4" />
      <div class="card thesis">
        <h2 class="h3">{thesis.label}</h2>
        <p class="prose">{thesis.body}</p>
      </div>
    </div>
  </section>

  <section aria-labelledby="process-h" class="section section--rule">
    <div class="wrap stack">
      <h2 id="process-h" class="h2">{t.process}</h2>
      <ol class="flow" aria-label={t.process}>
        {phases.map((p) => (
          <li class="flow__phase">
            <p class="flow__name"><span class="num">{String(p.n).padStart(2, "0")}</span> {p.name}</p>
            <ol class="flow__steps">
              {p.steps.map((s) => <li><a href={`#step-${s.n}`}><span class="flow__dot num">{s.n}</span><span>{s.title}</span></a></li>)}
            </ol>
          </li>
        ))}
      </ol>
      <div class="note"><Icon name="info" size={22} /><p><strong>{howTo.label}:</strong> {howTo.body}</p></div>

      {phases.map((p) => (
        <div class="phase">
          <h3 class="phase__title"><span class="num">{String(p.n).padStart(2, "0")}</span>{p.name}</h3>
          <div class="steps">
            {p.steps.map((s) => (
              <article class="step" id={`step-${s.n}`}>
                <p class="step__n num">{t.stepWord} {s.n}</p>
                <h4 class="step__title">{s.title}</h4>
                <dl>
                  <div><dt>{t.review}</dt><dd>{s.review}</dd></div>
                  <div class="step__risk"><dt>{t.risk}</dt><dd>{s.risk}</dd></div>
                  <div class="step__basis"><dt>{t.basis}</dt><dd>{s.basis}</dd></div>
                </dl>
              </article>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section aria-labelledby="example-h" class="section section--white section--rule">
    <div class="wrap stack">
      <h2 id="example-h" class="h2">{text("case4", "example_headline", lang)}</h2>
      <p class="prose" style="max-width:860px">{example.body}</p>
      <div class="table-box">
        <table class="etable">
          <thead><tr><th scope="col">{t.exScenario}</th><th scope="col">{t.exIrr}</th><th scope="col">{t.exNpv}</th><th scope="col">{t.exPeak}</th></tr></thead>
          <tbody>{scenarios.map((s, i) => <tr class={i === 0 ? "base" : ""}><th scope="row">{s.scenario}</th><td class="num">{s.irr}</td><td class="num">{s.npv}</td><td class="num">{s.peak}</td></tr>)}</tbody>
        </table>
      </div>
    </div>
  </section>

  <section aria-labelledby="lenses-h" class="section section--rule">
    <div class="wrap stack">
      <h2 id="lenses-h" class="h2">{text("case4", "lenses_headline", lang)}</h2>
      <div class="note"><Icon name="info" size={22} /><p><strong>{lensNote.label}:</strong> {lensNote.body}</p></div>
      <div class="grid lenses">
        {lenses.map((l) => (
          <div class="card lens">
            <h3 class="h3">{l.role}</h3>
            <ul class="lens__list">{l.points.map((x) => <li>{x}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <nav class="section--white section--rule" aria-label={t.next}>
    <div class="wrap pager">
      <a class="link-arrow" href={`/${lang}/cases/riverside-residences/`}><Icon name="arrow-left" size={16} />{prevName}</a>
      <a class="link-arrow" href={`/${lang}/#projects`}>{t.allProjects}<Icon name="arrow-right" size={16} /></a>
    </div>
  </nav>
</Base>

<style>
  .intro { padding-block: 40px 56px; gap: 20px; }
  .crumbs { font-size: 14px; color: var(--text-muted); display: flex; gap: 8px; flex-wrap: wrap; }
  .crumbs a { text-decoration: none; }
  .thesis { border-left: 4px solid var(--accent-decor); }

  /* process diagram: three phases, each a row of numbered steps joined by a line */
  .flow { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 4fr 3fr 2fr; gap: 14px; }
  .flow__phase { background: var(--surface); border: 1px solid var(--border); border-top: 4px solid var(--primary); border-radius: var(--radius); padding: 16px 18px 18px; }
  .flow__phase:nth-child(2) { border-top-color: #3f5f86; }
  .flow__phase:nth-child(3) { border-top-color: var(--accent-decor); }
  .flow__name { font-size: 13px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 14px; }
  .flow__name .num { color: var(--accent-text); margin-right: 4px; }
  .flow__steps { list-style: none; margin: 0; padding: 0; display: flex; gap: 10px; position: relative; }
  .flow__steps::before { content: ""; position: absolute; left: 16px; right: 16px; top: 16px; height: 2px; background: var(--border-strong); }
  .flow__steps li { flex: 1; position: relative; }
  .flow__steps a { display: flex; flex-direction: column; align-items: center; gap: 8px; text-align: center; text-decoration: none; color: var(--text); font-size: 14px; line-height: 1.35; min-height: 44px; }
  .flow__steps a:hover span:last-child { color: var(--primary); text-decoration: underline; }
  .flow__dot { width: 34px; height: 34px; border-radius: 50%; background: var(--primary); color: #fff; display: grid; place-items: center; font-weight: 700; font-size: 15px; position: relative; }
  @media (max-width: 900px) {
    .flow { grid-template-columns: 1fr; }
    .flow__steps { flex-direction: column; gap: 6px; }
    .flow__steps::before { left: 16px; right: auto; top: 16px; bottom: 16px; width: 2px; height: auto; }
    .flow__steps a { flex-direction: row; text-align: left; gap: 12px; }
  }

  .phase { display: flex; flex-direction: column; gap: 14px; margin-top: 12px; }
  .phase__title { font-size: 24px; display: flex; gap: 10px; align-items: baseline; }
  .phase__title .num { color: var(--accent-text); font-size: 20px; }
  .steps { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 330px), 1fr)); }
  .step { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 22px; display: flex; flex-direction: column; gap: 10px; scroll-margin-top: 96px; }
  .step:target { outline: 3px solid var(--accent-decor); outline-offset: 2px; }
  .step__n { font-size: 13px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--accent-text); }
  .step__title { font-family: var(--font-head); font-size: 20px; color: var(--primary); margin: 0; }
  .step dl { margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .step dt { font-size: 13px; font-weight: 700; color: var(--text-muted); }
  .step dd { margin: 2px 0 0; font-size: 15px; color: var(--text-2); }
  .step__risk { background: #fbf6ec; border-left: 3px solid var(--accent-decor); padding: 8px 10px; border-radius: 4px; }
  .step__basis dd { font-size: 13.5px; color: var(--text-muted); }

  .lens__q { font-style: italic; color: var(--text-2); }
  .lens__list { margin: 0; padding-left: 18px; display: flex; flex-direction: column; gap: 8px; color: var(--text-2); }
  .lens__list li::marker { color: var(--accent-text); }

  .etable { width: 100%; min-width: 560px; border-collapse: collapse; background: var(--surface); border: 1px solid var(--border); }
  .etable th, .etable td { padding: 12px 16px; border-bottom: 1px solid var(--border); text-align: right; }
  .etable th:first-child { text-align: left; }
  .etable thead th { font-size: 13px; letter-spacing: .04em; text-transform: uppercase; color: var(--text-muted); background: var(--bg); }
  .etable tr.base { background: var(--tint); }
  .pager { padding-block: 32px; display: flex; flex-wrap: wrap; gap: 16px; justify-content: space-between; }
</style>
