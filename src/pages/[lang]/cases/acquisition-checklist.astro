---
import Base from "../../../layouts/Base.astro";
import Icon from "../../../components/Icon.astro";
import { LANGS, type Lang, text, labelled, pipes, numbered, basis } from "../../../lib/content";
import { ui, DOWNLOADS } from "../../../lib/ui";

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const t = ui(lang);

const tags = pipes(text("case4", "tagline", lang));
const headline = text("case4", "headline", lang);
const scope = labelled("case4", "scope", lang);
const step0 = labelled("case4", "step0", lang);
const checks = ["check1", "check2", "check3", "check4", "check5", "check6"].map((id) => {
  const { label, body } = labelled("case4", id, lang);
  const m = label.match(/^(\d+)\. (.*)$/)!;
  return { n: m[1], title: m[2], ...basis(body) };
});
const flags = numbered(text("case4", "red_flags", lang));
const flagsLabel = labelled("case4", "red_flags", lang).label;
const price = labelled("case4", "into_price", lang);
const practice = labelled("case4", "from_practice", lang);
const officeName = pipes(text("case3", "tagline", lang))[1];
const pdf = DOWNLOADS.pdf[lang];
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
---
<Base lang={lang} title={`${t.checklist} – ${t.name}`} description={headline}>
  <section class="section--white">
    <div class="wrap stack intro">
      <nav aria-label={t.breadcrumb} class="crumbs">
        <a href={`/${lang}/#projects`}>{t.nav.projects}</a><span aria-hidden="true">/</span><span>{t.checklist}</span>
      </nav>
      <ul class="chips">{tags.map((c, i) => <li class={i === 0 ? "chip chip--key" : "chip"}>{c}</li>)}</ul>
      <h1 class="h1" style="max-width:920px;font-size:clamp(30px,4.4vw,50px)">{headline}</h1>
      <div class="note"><Icon name="info" size={22} /><p><strong>{scope.label}:</strong> {scope.body}</p></div>
      <div class="btn-row"><a class="btn btn--line" href={pdf.href} download={pdf.name}><Icon name="download" />{t.downloadPdf}</a></div>
    </div>
  </section>

  <section class="section section--rule">
    <div class="wrap stack">
      <div class="card step0">
        <h2 class="h3">{cap(step0.label)}</h2>
        <p class="prose">{cap(step0.body)}</p>
      </div>
      <ol class="grid checks">
        {checks.map((c) => (
          <li class="card" style="padding:24px;gap:10px">
            <div class="check__head"><span class="check__n num">{c.n.padStart(2, "0")}</span><h3 class="h3" style="font-size:20px">{c.title}</h3></div>
            <p class="prose" style="font-size:15px">{cap(c.body)}</p>
            {c.basis && <p class="basis"><strong>{t.basis}:</strong> {c.basis}</p>}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section aria-labelledby="flags-h" class="section section--white section--rule">
    <div class="wrap stack">
      <h2 id="flags-h" class="h2">{flagsLabel}</h2>
      <ol class="flags">{flags.map((f) => <li>{cap(f.replace(/;$/, ""))}</li>)}</ol>
      <div class="grid">
        <div class="card card--soft"><h3 class="h3">{price.label}</h3><p class="prose">{cap(price.body)}</p></div>
        <div class="card card--soft"><h3 class="h3">{practice.label}</h3><p class="prose">{cap(practice.body)}</p></div>
      </div>
    </div>
  </section>

  <nav class="section--rule" aria-label={t.next}>
    <div class="wrap pager">
      <a class="link-arrow" href={`/${lang}/#projects`}><Icon name="arrow-left" size={16} />{t.allProjects}</a>
      <a class="link-arrow" href={`/${lang}/cases/grade-b-office/`}>{t.next}: {officeName}<Icon name="arrow-right" size={16} /></a>
    </div>
  </nav>
</Base>

<style>
  .intro { padding-block: 40px 56px; gap: 20px; }
  .crumbs { font-size: 14px; color: var(--text-muted); display: flex; gap: 8px; flex-wrap: wrap; }
  .crumbs a { text-decoration: none; }
  .step0 { border-left: 0; border-top: 3px solid var(--primary); }
  .checks { list-style: none; margin: 0; padding: 0; }
  .check__head { display: flex; gap: 12px; align-items: baseline; }
  .check__n { font-family: var(--font-head); font-size: 24px; font-weight: 700; color: var(--accent-text); }
  .basis { font-size: 14px; color: var(--text-muted); border-top: 1px solid var(--border); padding-top: 10px; margin-top: auto; }
  .flags { margin: 0; padding-left: 24px; display: flex; flex-direction: column; gap: 10px; color: var(--text-2); max-width: 85ch; }
  .flags li::marker { color: var(--accent-text); font-weight: 700; }
  .pager { padding-block: 32px; display: flex; flex-wrap: wrap; gap: 16px; justify-content: space-between; }
</style>
