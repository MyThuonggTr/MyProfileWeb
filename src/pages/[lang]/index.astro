---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import { LANGS, type Lang, raw, text, labelled, pipes, items, titled } from "../../lib/content";
import { ui, DOWNLOADS, EMAIL } from "../../lib/ui";

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const t = ui(lang);

const title = text("hero", "title", lang);
const positioning = text("hero", "positioning", lang);
const stats = items("about", "key_figures", lang);
const steps = raw("map", "intro", lang).replace(/\.$/, "").split(" → ");
const c3tags = pipes(text("case3", "tagline", lang));
const c4tags = pipes(text("case4", "tagline", lang));
const chatbot = text("research", "chatbot_body", lang);
const award = chatbot.split(". ")[1];
const dow = titled(raw("research", "dowjones", lang));
const ebib = titled(raw("research", "ebib", lang));
const skills = pipes(raw("skills", "summary", lang).replace(/\.$/, ""));
const edu = raw("education", "summary", lang).replace(/\.$/, "");
const pdf = DOWNLOADS.pdf[lang];
---
<Base lang={lang} title={`${t.name} – ${title}`} description={positioning} home>
  <section id="top" class="section--white">
    <div class="wrap hero">
      <div class="hero__text">
        <div class="eyebrow eyebrow--line">{t.portfolio}</div>
        <h1 class="h1">{title}</h1>
        <p class="lead">{positioning}</p>
        <div class="btn-row">
          <a class="btn btn--solid" href="#projects">{t.viewProjects}</a>
          <a class="btn btn--line" href={pdf.href} download={pdf.name}><Icon name="download" />{t.downloadPdf}</a>
        </div>
      </div>
      <figure class="portrait">
        <div role="img" aria-label={t.portraitAlt} class="portrait__frame"><Icon name="person" size={56} /></div>
      </figure>
    </div>
  </section>

  <section id="about" aria-labelledby="about-h" class="section--white section--rule">
    <div class="wrap stack about">
      <h2 id="about-h" class="h2">{t.about}</h2>
      <div class="grid grid--stats">
        {stats.map((s) => (
          <div class="stat">
            <div class="stat__value num">{s.value}</div>
            <div class="stat__label">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="projects" aria-labelledby="projects-h" class="section">
    <div class="wrap stack">
      <div class="stack" style="gap:10px">
        <div class="eyebrow">{t.map}</div>
        <h2 id="projects-h" class="h2">{text("map", "headline", lang)}</h2>
      </div>
      <ol class="steps" aria-label={t.stepsLabel}>
        {steps.map((s, i) => <li class={i >= 2 ? "on" : undefined}>{i + 1} · {s}</li>)}
      </ol>
      <div class="grid">
        <article class="card card--link">
          <ul class="chips"><li class="chip chip--key">{steps[2]}</li><li class="chip">{c3tags[0]}</li></ul>
          <h3 class="h3" style="font-size:24px">{text("case3", "headline", lang)}</h3>
          <p class="meta">{c3tags.slice(1).join(" · ")}</p>
          <a class="link-arrow push" href={`/${lang}/cases/grade-b-office/`}>{t.readCase}<Icon name="arrow-right" size={16} /></a>
        </article>
        <article class="card card--link">
          <ul class="chips"><li class="chip chip--key">{steps[3]}</li><li class="chip">{c4tags[0]}</li></ul>
          <h3 class="h3" style="font-size:24px">{text("case4", "headline", lang)}</h3>
          <p class="meta">{c4tags.slice(1).join(" · ")}</p>
          <a class="link-arrow push" href={`/${lang}/cases/acquisition-checklist/`}>{t.readChecklist}<Icon name="arrow-right" size={16} /></a>
        </article>
      </div>
    </div>
  </section>

  <section id="research" aria-labelledby="research-h" class="section section--white section--rule">
    <div class="wrap stack">
      <div class="stack" style="gap:10px">
        <div class="eyebrow">{t.research}</div>
        <h2 id="research-h" class="h2">{text("research", "headline", lang)}</h2>
      </div>
      <article class="card card--soft">
        <ul class="chips"><li class="chip chip--solid">{award}</li></ul>
        <h3 class="h3">{text("research", "chatbot_title", lang)}</h3>
        <p class="prose">{chatbot}</p>
      </article>
      <div class="grid">
        {[dow, ebib].map((r) => (
          <article class="card">
            <p class="meta">{r.meta}</p>
            <h3 class="h3" style="font-size:20px">{r.title}</h3>
            <p class="prose" style="font-size:15px">{r.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="skills" aria-labelledby="skills-h" class="section section--rule">
    <div class="wrap split">
      <div class="stack split__main" style="gap:18px">
        <h2 id="skills-h" class="h2">{t.skills}</h2>
        <ul class="skill-list">{skills.map((s) => <li>{s}</li>)}</ul>
      </div>
      <div class="stack split__side" style="gap:18px">
        <h2 class="h2">{t.education}</h2>
        <div class="card" style="padding:24px;gap:6px">
          <p class="edu">{edu}</p>
        </div>
      </div>
    </div>
  </section>

  <section id="contact" aria-labelledby="contact-h" class="contact">
    <div class="wrap contact__in">
      <div class="stack" style="gap:12px;flex:999 1 420px;min-width:0">
        <h2 id="contact-h" class="h2" style="color:#fff">{t.contact}</h2>
        <a class="contact__mail" href={`mailto:${EMAIL}`}>{EMAIL}</a>
      </div>
      <div class="btn-row" style="flex:1 1 260px">
        <a class="btn btn--white" href={DOWNLOADS.pdf.en.href} download={DOWNLOADS.pdf.en.name} hreflang="en"><Icon name="download" />{t.pdfEn}</a>
        <a class="btn btn--ghost-white" href={DOWNLOADS.pdf.vi.href} download={DOWNLOADS.pdf.vi.name} hreflang="vi"><Icon name="download" />{t.pdfVi}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: 72px 64px; display: flex; flex-wrap: wrap; gap: 48px; align-items: center; }
  .hero__text { flex: 999 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
  .hero .btn-row { padding-top: 8px; }
  .portrait { flex: 1 1 240px; max-width: 320px; margin: 0; }
  .portrait__frame { aspect-ratio: 4 / 5; border-radius: 8px; background: var(--tint); border: 1.5px dashed #9aa6b6; display: flex; align-items: center; justify-content: center; color: var(--text-muted); }
  .about { padding-block: 48px; border-bottom: 1px solid var(--border); }
  .meta { font-size: 14px; color: var(--text-muted); }
  .push { margin-top: auto; align-self: flex-start; }
  .split { display: flex; flex-wrap: wrap; gap: 40px; }
  .split__main { flex: 999 1 520px; min-width: 0; }
  .split__side { flex: 1 1 300px; min-width: 0; }
  .skill-list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; font-size: 15px; font-weight: 500; }
  .skill-list li { padding: 10px 16px; border-radius: 6px; background: var(--surface); border: 1px solid var(--border); color: var(--primary); }
  .edu { color: var(--text-2); font-size: 17px; }
  .contact { background: var(--primary); color: #fff; border-bottom: 1px solid #3a5578; }
  .contact__in { padding-block: 64px; display: flex; flex-wrap: wrap; gap: 32px; align-items: flex-end; justify-content: space-between; }
  .contact__mail { color: #fff; font-size: clamp(17px, 2vw, 22px); font-weight: 500; overflow-wrap: anywhere; }
  .contact__mail:hover { color: var(--on-primary-muted); }
</style>
