---
// 16:9 print version of the site; scripts/build-pdf.mjs turns it into the downloadable PDFs.
// Reading order matches the website: profile, project overview, cases, research, contact.
import "@fontsource-variable/inter";
import "@fontsource-variable/source-serif-4";
import "../../../styles/global.css";
import { LANGS, type Lang, raw, text, labelled, pipes, numbered, clauses, items, titled, basis, attr, card, job, rowIds, rich } from "../../../lib/content";
import { ui, EMAIL, PHONE, CASES, FILES, fileOf } from "../../../lib/ui";

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const t = ui(lang);
const site = import.meta.env.PUBLIC_SITE_URL as string | undefined;
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

const title = text("hero", "title", lang);
const target = text("hero", "target", lang);
const jobs = ["dkra", "em", "skl"].map((id) => job("experience", id, lang));
const acts = ["margroup"].map((id) => job("activities", id, lang));
const edu = raw("education", "summary", lang).split(" | ");
const eduPoints = edu[2].split(/(?<=\.) (?=[A-ZĐÀ-Ỹ])/u);
const creds = ["valuation", "english", "chinese", "ic3"].map((id) => raw("credentials", id, lang));
const skills = rowIds("skills_map").filter((id) => id !== "headline").map((id) => raw("skills_map", id, lang).split(" | "));
const tagsOf = (b: string) => pipes(text(b, "tagline", lang));
const chipsOf = (b: string) => { const tg = tagsOf(b); return [...tg.slice(0, -1), ...tg.at(-1)!.split(". ")]; };
type Step = { phase: number; title: string; review: string; risk: string; basis: string };
const steps = rich<Step>("case4", "steps", lang).map((x, k) => ({ ...x, n: k + 1 }));
const phaseNames = pipes(text("case4", "phases", lang));
const proc = rich<{ phase: number; title: string; work: string; output: string; who: string; legal: number[] }>("case4", "process", lang).map((x, k) => ({ ...x, n: k + 1 }));
const ownerOf = Object.fromEntries(proc.flatMap((x) => x.legal.map((k) => [k, x.n])));
const lenses = rich<{ role: string; points: string[] }>("case4", "lenses", lang);
const scenarios = rich<{ scenario: string; irr: string; npv: string; peak: string }>("case4", "example", lang);
const chatbot = text("research", "chatbot_body", lang);
const dow = titled(raw("research", "dowjones", lang));
const ebib = titled(raw("research", "ebib", lang));
const principles = ["p1", "p2", "p3"].map((id) => labelled("principles", id, lang));
const L = (b: string, id: string) => labelled(b, id, lang);
const month = "11/2026";
const pageLabel = lang === "vi" ? "Trang" : "Page";
const slides = 22;
let n = 0;
const foot = () => `${t.name} · ${target} · ${pageLabel} ${++n}/${slides}`;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=1280" />
  <meta name="robots" content="noindex" />
  <title>{title} – {t.name} (PDF)</title>
</head>
<body class="print">
  <!-- 1 Cover -->
  <section class="slide cover">
    <div class="eyebrow eyebrow--line" style="color:var(--accent-decor)">{title} · {month}</div>
    <h1>{t.name}</h1>
    <p class="cover__target">{target}</p>
    <p class="cover__mail">{EMAIL} · {PHONE.display}{site && <> · {site.replace(/^https?:\/\//, "")}</>}</p>
    <p class="cover__note">{raw("disclaimer", "text", lang)}</p>
    <footer>{foot()}</footer>
  </section>

  <!-- 2 Profile and core competencies -->
  <section class="slide dense">
    <div class="eyebrow">{t.profile}</div>
    <p class="lead">{text("hero", "positioning", lang)}</p>
    <div class="row4">
      {items("about", "key_figures", lang).map((s) => <div class="stat"><div class="stat__value num">{s.value}</div><div class="stat__label">{s.label}</div></div>)}
    </div>
    <h3>{text("skills_map", "headline", lang)}</h3>
    <table class="ptable"><thead><tr><th>{t.skill}</th><th>{t.evidence}</th></tr></thead>{skills.map(([s, e]) => <tr><th>{s}</th><td>{e}</td></tr>)}</table>
    <footer>{foot()}</footer>
  </section>

  <!-- 3 Project overview -->
  <section class="slide">
    <div class="eyebrow">{t.projects}</div>
    <h2>{t.selectedWork}</h2>
    <div class="row3">
      {CASES.map((c) => {
        const k = card(c.key, lang);
        return (
          <div class="box pcard">
            <p class="kind">{tagsOf(c.key)[0].replace(/\s*\(.*\)$/, "")}</p>
            <h3>{text(c.key, "headline", lang)}</h3>
            <p class="muted">{text(c.key, "question", lang)}</p>
            <p class="big num">{k.value}</p>
            <p class="muted">{k.label}</p>
            <p class="muted">{t.tools}: {k.tools}</p>
          </div>
        );
      })}
    </div>
    <p class="muted">{t.research}: {text("research", "headline", lang)}.</p>
    <footer>{foot()}</footer>
  </section>

  <!-- 4–6 Grade-B office -->
  <section class="slide">
    <ul class="chips">{chipsOf("case3").map((c, i) => <li class={i === 0 ? "chip chip--key" : "chip"}>{c}</li>)}</ul>
    <h2>{text("case3", "headline", lang)}</h2>
    <p class="lead"><strong>{t.question}:</strong> {text("case3", "question", lang)}</p>
    <div class="row4">
      {items("case3", "key_figures", lang).map((s, i) => <div class={i === 0 ? "stat stat--solid" : "stat"}><div class="stat__value num">{s.value}</div><div class="stat__label">{s.label}</div></div>)}
    </div>
    <p class="body"><strong>{L("case3", "role").label}:</strong> {L("case3", "role").body}</p>
    <footer>{foot()}</footer>
  </section>
  <section class="slide">
    <div class="eyebrow">{t.approach}</div>
    <h2>{text("case3", "approach_headline", lang)}</h2>
    <ol class="row3 numbered">{numbered(text("case3", "approach", lang)).map((a, i) => <li class="box"><span class="n num">{String(i + 1).padStart(2, "0")}</span><p>{a}</p></li>)}</ol>
    <footer>{foot()}</footer>
  </section>
  <section class="slide">
    <div class="eyebrow">{t.sensitivity}</div>
    <h2>{text("case3", "sensitivity_headline", lang)}</h2>
    <div class="row-chart">
      <img src={`/images/case3-sensitivity-heatmap-${lang}.png`} alt={t.sensCaption} />
      <div class="box"><h3>{L("case3", "lessons").label}</h3><ul class="list">{clauses(L("case3", "lessons").body).map((l) => <li>{l}</li>)}</ul></div>
    </div>
    <footer>{foot()}</footer>
  </section>

  <!-- 7–9 Riverside Residences -->
  <section class="slide">
    <ul class="chips">{chipsOf("case2").map((c, i) => <li class={i === 0 ? "chip chip--key" : "chip"}>{c}</li>)}</ul>
    <h2>{text("case2", "headline", lang)}</h2>
    <p class="lead"><strong>{t.question}:</strong> {text("case2", "question", lang)}</p>
    <div class="row4">
      {items("case2", "key_figures", lang).map((s, i) => <div class={i === 0 ? "stat stat--solid" : "stat"}><div class="stat__value num">{s.value}</div><div class="stat__label">{s.label}</div></div>)}
    </div>
    <p class="body"><strong>{L("case2", "role").label}:</strong> {cap(L("case2", "role").body)}</p>
    <footer>{foot()}</footer>
  </section>
  <section class="slide dense">
    <div class="eyebrow">{t.approach}</div>
    <div class="row-model">
      <img src={`/images/case2-model-map-${lang}.png`} alt={t.modelMap} />
      <ol class="steps-v">{numbered(text("case2", "approach", lang)).map((a, i) => <li><span class="n num">{String(i + 1).padStart(2, "0")}</span> {a}</li>)}</ol>
    </div>
    <footer>{foot()}</footer>
  </section>
  <section class="slide">
    <div class="eyebrow">{t.funding}</div>
    <div class="row-chart wide">
      <img src={`/images/case2-funding-and-sensitivity-${lang}.png`} alt={text("case2", "funding_headline", lang)} />
      <div class="box">
        <p><strong>{L("case2", "sensitivity").label}:</strong> {L("case2", "sensitivity").body}</p>
        <h3 style="margin-top:12px">{L("case2", "lessons").label}</h3>
        <ul class="list">{clauses(L("case2", "lessons").body).map((l) => <li>{l}</li>)}</ul>
      </div>
    </div>
    <footer>{foot()}</footer>
  </section>

  <!-- Legal review across the project life cycle -->
  <section class="slide dense">
    <ul class="chips">{tagsOf("case4").map((c, i) => <li class={i === 0 ? "chip chip--key" : "chip"}>{c}</li>)}</ul>
    <h2>{text("case4", "headline", lang)}</h2>
    <p class="lead"><strong>{t.question}:</strong> {text("case4", "question", lang)}</p>
    <div class="box box--line"><p><strong>{L("case4", "thesis").label}:</strong> {L("case4", "thesis").body}</p></div>
    <div class="pflow">
      {phaseNames.map((name, k) => (
        <div class="pflow__phase">
          <p class="pflow__name">{String(k + 1).padStart(2, "0")} · {name}</p>
          <ol class="pflow__steps">{proc.filter((x) => x.phase === k + 1).map((x) => <li><span class="pflow__dot">{x.n}</span>{x.title}{x.legal.length > 0 && <em class="pflow__tag">◆ {t.legalTag}</em>}</li>)}</ol>
        </div>
      ))}
    </div>
    <p class="small muted"><strong>{L("case4", "how_to_read").label}:</strong> {L("case4", "how_to_read").body}</p>
    <footer>{foot()}</footer>
  </section>
  {[[0, 5], [5, 10]].map(([a, b]) => (
    <section class="slide dense">
      <h2>{t.part1}</h2>
      <table class="ctable">
        <thead><tr><th>#</th><th>{t.stepWord}</th><th>{t.work}</th><th>{t.output}</th></tr></thead>
        <tbody>
          {proc.slice(a, b).map((x) => (
            <tr>
              <td class="n num">{String(x.n).padStart(2, "0")}</td>
              <th>{x.title}{x.legal.length > 0 && <p class="small">◆ {t.legalCheck} {x.legal.map((k) => `P${k}`).join(", ")}</p>}</th>
              <td class="body">{x.work}<p class="small">{t.who}: {x.who}</p></td>
              <td class="risk">{x.output}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <footer>{foot()}</footer>
    </section>
  ))}
  {[[0, 3], [3, 6], [6, 7], [7, 9]].map(([a, b], k, all) => (
    <section class="slide dense">
      <h2>{t.legalCheck} P1–P9</h2>
      <table class="ctable">
        <thead><tr><th>#</th><th>{t.legalCheck}</th><th>{t.review}</th><th>{t.risk}</th></tr></thead>
        <tbody>
          {steps.slice(a, b).map((x) => (
            <tr>
              <td class="n num">{String(x.n).padStart(2, "0")}</td>
              <th>{x.title}<p class="small">P{x.n} · {t.atStep} {ownerOf[x.n]}</p></th>
              <td class="body">{x.review}<p class="small">{t.basis}: {x.basis}</p></td>
              <td class="risk">{x.risk}</td>
            </tr>
          ))}
        </tbody>
      </table>
      {k === all.length - 1 && (
        <div class="ex">
          <h3>{text("case4", "example_headline", lang)}</h3>
          <table class="ctable etable">
            <thead><tr><th>{t.exScenario}</th><th>{t.exIrr}</th><th>{t.exNpv}</th><th>{t.exPeak}</th></tr></thead>
            <tbody>{scenarios.map((x) => <tr><th>{x.scenario}</th><td class="num">{x.irr}</td><td class="num">{x.npv}</td><td class="num">{x.peak}</td></tr>)}</tbody>
          </table>
        </div>
      )}
      <footer>{foot()}</footer>
    </section>
  ))}
  <section class="slide dense">
    <h2>{text("case4", "lenses_headline", lang)}</h2>
    <p class="small muted"><strong>{L("case4", "lenses_note").label}:</strong> {L("case4", "lenses_note").body}</p>
    <div class="row3">{lenses.map((l) => <div class="box"><h3>{l.role}</h3><ul class="list small">{l.points.map((x) => <li>{x}</li>)}</ul></div>)}</div>
    <footer>{foot()}</footer>
  </section>

  <!-- 12 Research -->
  <section class="slide dense">
    <div class="eyebrow">{t.research}</div>
    <h2>{text("research", "headline", lang)}</h2>
    <div class="box"><h3>{text("research", "chatbot_title", lang)}</h3><p>{chatbot}</p></div>
    <div class="row2">
      {[dow, ebib].map((r) => <div class="box"><p class="muted">{r.meta}</p><h3>{r.title}</h3><p>{r.body}</p></div>)}
    </div>
    <footer>{foot()}</footer>
  </section>

  <!-- Experience (every point of every role); education, credentials and activities -->
  <section class="slide dense">
    <div class="row-exp">
      <div>
        <h3>{text("experience", "headline", lang)}</h3>
        {jobs.map((j) => <div class="job"><p><strong>{j.role}</strong> · {j.org} <span class="muted num">· {j.period}</span></p><ul class="list small">{j.points.map((p) => <li>{p}</li>)}</ul></div>)}
      </div>
      <div>
        <h3>{t.education}</h3>
        <p><strong>{edu[0]}</strong> <span class="muted num">· {edu[1]}</span></p>
        <ul class="list small">{eduPoints.map((p) => <li>{p}</li>)}</ul>
        <h3 style="margin-top:8px">{t.credentials}</h3>
        <ul class="list small">{creds.map((c) => <li>{c}</li>)}</ul>
        <h3 style="margin-top:8px">{text("activities", "headline", lang)}</h3>
        {acts.map((j) => <p><strong>{j.role}</strong> · {j.org} <span class="muted num">· {j.period}</span></p>)}
      </div>
    </div>
    <footer>{foot()}</footer>
  </section>

  <!-- 13 How I check a model -->
  <section class="slide">
    <h2>{text("principles", "headline", lang)}</h2>
    <ol class="row3 numbered">{principles.map((p) => <li class="box"><h3>{p.label}</h3><p>{cap(p.body)}</p></li>)}</ol>
    <div class="box box--line"><p><strong>{L("principles", "next").label}:</strong> {cap(L("principles", "next").body)}</p></div>
    <footer>{foot()}</footer>
  </section>

  <!-- 15 Downloads -->
  <section class="slide dense">
    <h2>{t.downloads}</h2>
    <p class="muted">{t.personalNote}</p>
    <table class="ptable ftable"><colgroup><col style="width:44%" /><col style="width:10%" /><col style="width:46%" /></colgroup><thead><tr><th>{t.file}</th><th>{t.fileType}</th><th>File</th></tr></thead>
      {FILES.map((f) => <tr><th>{f[lang]}</th><td>{f.type}</td><td class="small">{fileOf(f.key).name}{site && <><br />{site.replace(/\/$/, "")}{fileOf(f.key).href}</>}</td></tr>)}
    </table>
    <footer>{foot()}</footer>
  </section>

  <!-- 16 Contact -->
  <section class="slide cover">
    <h2 style="color:#fff">{t.contact}</h2>
    <p class="cover__target" style="color:#fff">{EMAIL}</p>
    <p class="cover__target" style="color:#fff">{PHONE.display}</p>
    {site && <p class="cover__mail">{site}</p>}
    <p class="cover__note">{raw("disclaimer", "text", lang)}</p>
    <footer>{foot()}</footer>
  </section>
</body>
</html>

<style is:global>
  @page { size: 1280px 720px; margin: 0; }
  html, body.print { background: #8a94a3; }
  body.print { margin: 0; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .slide { position: relative; width: 1280px; height: 720px; overflow: hidden; background: #fff; padding: 56px 72px 72px; display: flex; flex-direction: column; gap: 22px; margin: 0 auto 24px; break-after: page; font-size: 17px; }
  @media print { .slide { margin: 0; } html, body.print { background: #fff; } }
  .slide h1 { font-size: 64px; line-height: 1.08; color: #fff; }
  .slide h2 { font-size: 34px; line-height: 1.15; max-width: 1100px; }
  .slide h3 { font-size: 19px; line-height: 1.3; margin-bottom: 6px; }
  .slide p { color: var(--text-2); }
  .slide .lead { font-size: 19px; max-width: 1080px; }
  .slide footer { position: absolute; left: 72px; right: 72px; bottom: 26px; font-size: 13px; color: var(--text-muted); border-top: 1px solid var(--border); padding-top: 10px; }
  .cover { background: var(--primary); justify-content: center; }
  .cover p { color: var(--on-primary-muted); }
  .cover__target { font-size: 28px; color: var(--accent-decor) !important; font-weight: 600; }
  .cover__mail { font-size: 19px; }
  .cover__note { font-size: 15px; margin-top: 24px; }
  .cover footer { color: var(--on-primary-muted); border-top-color: #3a5578; }
  .row2, .row3, .row4 { display: grid; gap: 18px; list-style: none; margin: 0; padding: 0; }
  .row2 { grid-template-columns: 1fr 1fr; }
  .row3 { grid-template-columns: repeat(3, 1fr); }
  .row4 { grid-template-columns: repeat(4, 1fr); }
  .box { background: var(--bg); border-radius: 10px; padding: 20px 22px; }
  .box--line { background: #fff; border: 1px solid var(--border); }
  .muted { color: var(--text-muted) !important; font-size: 15px; }
  .numbered .n, .steps-v .n, .ctable .n { font-family: var(--font-head); font-size: 24px; font-weight: 700; color: var(--accent-text); }
  .numbered .n { display: block; }
  .stat__value { font-size: 28px; }
  .plain { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; color: var(--text-2); }
  .ptable { border-collapse: collapse; width: 100%; font-size: 15px; }
  .ptable th, .ptable td { text-align: left; vertical-align: top; padding: 7px 10px; border-bottom: 1px solid var(--border); }
  .ptable th { color: var(--primary); width: 44%; }
  .pcard { display: flex; flex-direction: column; gap: 6px; }
  .pcard .kind { font-size: 13px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--eyebrow); }
  .pcard .big { font-family: var(--font-head); font-size: 34px; font-weight: 700; color: var(--primary); margin-top: auto; }
  .row-chart { display: grid; grid-template-columns: 760px 1fr; gap: 24px; align-items: start; }
  .row-chart.wide { grid-template-columns: 820px 1fr; }
  .row-chart img { width: 100%; border: 1px solid var(--border); border-radius: 8px; }
  .row-model { display: grid; grid-template-columns: 640px 1fr; gap: 24px; align-items: start; }
  .row-model img { width: 640px; border: 1px solid var(--border); border-radius: 8px; }
  .steps-v { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; color: var(--text-2); }
  .list { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 6px; color: var(--text-2); }
  .ctable { border-collapse: collapse; width: 100%; font-size: 15px; }
  .ctable th, .ctable td { text-align: left; vertical-align: top; padding: 8px 10px; border-bottom: 1px solid var(--border); }
  .ctable thead th { font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--text-muted); background: var(--bg); }
  .ctable tbody th { color: var(--primary); font-family: var(--font-head); font-size: 17px; width: 17%; }
  .ctable .body { font-size: 14px; width: 48%; }
  .ctable .small { font-size: 12px; color: var(--text-muted); margin-top: 4px; }
  .ctable .risk { font-size: 13.5px; color: var(--text-2); width: 30%; }
  .etable td, .etable th { font-size: 14px; }
  .ex { margin-top: 4px; }
  .ex h3 { font-size: 16px; margin-bottom: 2px; }
  .ex .ctable th, .ex .ctable td { padding: 5px 10px; }
  .pflow { display: grid; grid-template-columns: 3fr 5fr 2fr; gap: 12px; }
  .pflow__tag { font-style: normal; font-size: 10.5px; font-weight: 700; color: var(--accent-text); }
  .pflow__phase:nth-child(2) { border-top-color: #3f5f86; }
  .pflow__phase { border: 1px solid var(--border); border-top: 4px solid var(--primary); border-radius: 8px; padding: 10px 12px; }
  .pflow__phase:nth-child(3) { border-top-color: var(--accent-decor); }
  .pflow__name { font-size: 12px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 8px; }
  .pflow__steps { list-style: none; margin: 0; padding: 0; display: flex; gap: 8px; }
  .pflow__steps li { flex: 1; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 6px; font-size: 13px; line-height: 1.3; }
  .pflow__dot { width: 28px; height: 28px; border-radius: 50%; background: var(--primary); color: #fff; display: grid; place-items: center; font-weight: 700; font-size: 13px; }
  .ctable .list { font-size: 14.5px; gap: 3px; }
  .body { font-size: 17px; }
  .ftable th, .ftable td { padding: 4px 10px; font-size: 13px; }
  .ftable { table-layout: fixed; }
  .ftable th { width: auto !important; }
  .row-exp { display: grid; grid-template-columns: 1.25fr 1fr; gap: 28px; }
  .job { margin-bottom: 6px; }
  .list.small, td.small { font-size: 13.5px; }
  .ptable thead th { font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--text-muted); background: var(--bg); }
  .dense { gap: 16px; font-size: 15.5px; line-height: 1.45; }
  .dense .box { padding: 16px 20px; }
</style>
