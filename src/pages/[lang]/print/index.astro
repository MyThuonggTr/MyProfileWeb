---
// 16:9 print version of the site; scripts/build-pdf.mjs turns it into the downloadable PDFs.
import "@fontsource-variable/inter";
import "@fontsource-variable/source-serif-4";
import "../../../styles/global.css";
import { LANGS, type Lang, raw, text, labelled, pipes, numbered, clauses, items, titled, basis } from "../../../lib/content";
import { ui, EMAIL } from "../../../lib/ui";

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const t = ui(lang);
const site = import.meta.env.PUBLIC_SITE_URL as string | undefined;
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

const title = text("hero", "title", lang);
const steps = raw("map", "intro", lang).replace(/\.$/, "").split(" → ");
const c3tags = pipes(text("case3", "tagline", lang));
const c3last = c3tags[2].split(". ");
const c4tags = pipes(text("case4", "tagline", lang));
const checks = ["check1", "check2", "check3", "check4", "check5", "check6"].map((id) => {
  const { label, body } = labelled("case4", id, lang);
  const m = label.match(/^(\d+)\. (.*)$/)!;
  return { n: m[1], title: m[2], ...basis(body) };
});
const chatbot = text("research", "chatbot_body", lang);
const dow = titled(raw("research", "dowjones", lang));
const ebib = titled(raw("research", "ebib", lang));
const principles = ["p1", "p2", "p3"].map((id) => labelled("principles", id, lang));
const month = "11/2026";
const pageLabel = lang === "vi" ? "Trang" : "Page";
const slides = 13;
let n = 0;
const foot = () => `${t.name} · ${title} · ${pageLabel} ${++n}/${slides}`;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=1280" />
  <meta name="robots" content="noindex" />
  <title>{title} – {t.name} (PDF)</title>
</head>
<body class="print">
  <!-- 1 Cover -->
  <section class="slide cover">
    <div class="eyebrow eyebrow--line" style="color:var(--accent-decor)">{t.portfolio} · {month}</div>
    <h1>{title}</h1>
    <p class="cover__name">{t.name}</p>
    <p class="cover__mail">{EMAIL}{site && <> · {site.replace(/^https?:\/\//, "")}</>}</p>
    <p class="cover__note">{raw("disclaimer", "text", lang)}</p>
    <footer>{foot()}</footer>
  </section>

  <!-- 2 About -->
  <section class="slide">
    <div class="eyebrow">{t.about}</div>
    <h2>{t.name}</h2>
    <p class="lead">{text("hero", "positioning", lang)}</p>
    <div class="row3">
      {items("about", "key_figures", lang).map((s) => <div class="stat"><div class="stat__value num">{s.value}</div><div class="stat__label">{s.label}</div></div>)}
    </div>
    <div class="row2">
      <div><h3>{t.skills}</h3><ul class="pills">{pipes(raw("skills", "summary", lang).replace(/\.$/, "")).map((s) => <li>{s}</li>)}</ul></div>
      <div><h3>{t.education}</h3><p>{raw("education", "summary", lang).replace(/\.$/, "")}</p></div>
    </div>
    <footer>{foot()}</footer>
  </section>

  <!-- 3 Portfolio map -->
  <section class="slide">
    <div class="eyebrow">{t.map}</div>
    <h2>{text("map", "headline", lang)}</h2>
    <ol class="steps">{steps.map((s, i) => <li class={i >= 2 ? "on" : undefined}>{i + 1} · {s}</li>)}</ol>
    <div class="row2">
      <div class="box"><span class="chip chip--key">{steps[2]} · {c3tags[0]}</span><h3>{text("case3", "headline", lang)}</h3><p class="muted">{c3tags[1]} · {c3last[0]}</p></div>
      <div class="box"><span class="chip chip--key">{steps[3]}</span><h3>{text("case4", "headline", lang)}</h3><p class="muted">{c4tags.slice(1).join(" · ")}</p></div>
    </div>
    <footer>{foot()}</footer>
  </section>

  <!-- 4 Case 3 tear sheet -->
  <section class="slide">
    <ul class="chips">{[...c3tags.slice(0, 2), ...c3last].map((c, i) => <li class={i === 0 ? "chip chip--key" : "chip"}>{c}</li>)}</ul>
    <h2>{text("case3", "headline", lang)}</h2>
    <p class="lead"><strong>{t.question}:</strong> {text("case3", "question", lang)}</p>
    <div class="row4">
      {items("case3", "key_figures", lang).map((s, i) => <div class={i === 0 ? "stat stat--solid" : "stat"}><div class="stat__value num">{s.value}</div><div class="stat__label">{s.label}</div></div>)}
    </div>
    <p class="body"><strong>{labelled("case3", "role", lang).label}:</strong> {labelled("case3", "role", lang).body}</p>
    <footer>{foot()}</footer>
  </section>

  <!-- 5 Case 3 method -->
  <section class="slide">
    <div class="eyebrow">{t.approach}</div>
    <h2>{text("case3", "approach_headline", lang)}</h2>
    <ol class="row3 numbered">{numbered(text("case3", "approach", lang)).map((a, i) => <li class="box"><span class="n num">{String(i + 1).padStart(2, "0")}</span><p>{a}</p></li>)}</ol>
    <div class="box box--line"><p><strong>{labelled("case3", "special_assumption", lang).label}:</strong> {labelled("case3", "special_assumption", lang).body}</p></div>
    <footer>{foot()}</footer>
  </section>

  <!-- 6 Case 3 sensitivity and lessons -->
  <section class="slide">
    <div class="eyebrow">{t.sensitivity}</div>
    <h2>{text("case3", "sensitivity_headline", lang)}</h2>
    <div class="row-chart">
      <img src={`/images/case3-sensitivity-heatmap-${lang}.png`} alt={t.sensCaption} />
      <div class="box">
        <h3>{labelled("case3", "lessons", lang).label}</h3>
        <ul class="list">{clauses(labelled("case3", "lessons", lang).body).map((l) => <li>{l}</li>)}</ul>
      </div>
    </div>
    <footer>{foot()}</footer>
  </section>

  <!-- 7 Case 4 intro -->
  <section class="slide">
    <ul class="chips">{c4tags.map((c, i) => <li class={i === 0 ? "chip chip--key" : "chip"}>{c}</li>)}</ul>
    <h2>{text("case4", "headline", lang)}</h2>
    <div class="box box--line"><p><strong>{labelled("case4", "scope", lang).label}:</strong> {labelled("case4", "scope", lang).body}</p></div>
    <div class="box"><h3>{cap(labelled("case4", "step0", lang).label)}</h3><p>{cap(labelled("case4", "step0", lang).body)}</p></div>
    <footer>{foot()}</footer>
  </section>

  <!-- 8–9 Case 4 checks -->
  {[checks.slice(0, 3), checks.slice(3)].map((group) => (
    <section class="slide">
      <div class="eyebrow">{t.checklist}</div>
      <ol class="row3 checks">
        {group.map((c) => (
          <li class="box">
            <h3><span class="n num">{c.n.padStart(2, "0")}</span> {c.title}</h3>
            <p>{cap(c.body)}</p>
            {c.basis && <p class="basis"><strong>{t.basis}:</strong> {c.basis}</p>}
          </li>
        ))}
      </ol>
      <footer>{foot()}</footer>
    </section>
  ))}

  <!-- 10 Red flags -->
  <section class="slide">
    <h2>{labelled("case4", "red_flags", lang).label}</h2>
    <ol class="flags">{numbered(text("case4", "red_flags", lang)).map((f) => <li>{cap(f.replace(/;$/, ""))}</li>)}</ol>
    <div class="row2">
      <div class="box"><h3>{labelled("case4", "into_price", lang).label}</h3><p>{cap(labelled("case4", "into_price", lang).body)}</p></div>
      <div class="box"><h3>{labelled("case4", "from_practice", lang).label}</h3><p>{cap(labelled("case4", "from_practice", lang).body)}</p></div>
    </div>
    <footer>{foot()}</footer>
  </section>

  <!-- 11 Research -->
  <section class="slide dense">
    <div class="eyebrow">{t.research}</div>
    <h2>{text("research", "headline", lang)}</h2>
    <div class="box"><h3>{text("research", "chatbot_title", lang)}</h3><p>{chatbot}</p></div>
    <div class="row2">
      {[dow, ebib].map((r) => <div class="box"><p class="muted">{r.meta}</p><h3>{r.title}</h3><p>{r.body}</p></div>)}
    </div>
    <footer>{foot()}</footer>
  </section>

  <!-- 12 How I check a model -->
  <section class="slide">
    <h2>{text("principles", "headline", lang)}</h2>
    <ol class="row3 numbered">{principles.map((p) => <li class="box"><h3>{p.label}</h3><p>{cap(p.body)}</p></li>)}</ol>
    <div class="box box--line"><p><strong>{labelled("principles", "next", lang).label}:</strong> {cap(labelled("principles", "next", lang).body)}</p></div>
    <footer>{foot()}</footer>
  </section>

  <!-- 13 Contact -->
  <section class="slide cover">
    <h2 style="color:#fff">{t.contact}</h2>
    <p class="cover__name">{EMAIL}</p>
    {site && <p class="cover__mail">{site}</p>}
    <p class="cover__note">{raw("disclaimer", "text", lang)}</p>
    <footer>{foot()}</footer>
  </section>
</body>
</html>

<style is:global>
  @page { size: 1280px 720px; margin: 0; }
  html, body.print { background: #8a94a3; }
  body.print { margin: 0; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .slide { position: relative; width: 1280px; height: 720px; overflow: hidden; background: #fff; padding: 56px 72px 72px; display: flex; flex-direction: column; gap: 22px; margin: 0 auto 24px; break-after: page; font-size: 17px; }
  @media print { .slide { margin: 0; } html, body.print { background: #fff; } }
  .slide h1 { font-size: 60px; line-height: 1.08; max-width: 980px; }
  .slide h2 { font-size: 36px; line-height: 1.15; max-width: 1080px; }
  .slide h3 { font-size: 20px; line-height: 1.3; margin-bottom: 6px; }
  .slide p { color: var(--text-2); }
  .slide .lead { font-size: 19px; max-width: 1000px; }
  .slide footer { position: absolute; left: 72px; right: 72px; bottom: 26px; font-size: 13px; color: var(--text-muted); border-top: 1px solid var(--border); padding-top: 10px; }
  .cover { background: var(--primary); justify-content: center; }
  .cover h1 { color: #fff; }
  .cover p { color: var(--on-primary-muted); }
  .cover__name { font-size: 26px; color: #fff !important; font-weight: 600; }
  .cover__mail { font-size: 19px; }
  .cover__note { font-size: 15px; margin-top: 24px; }
  .cover footer { color: var(--on-primary-muted); border-top-color: #3a5578; }
  .row2, .row3, .row4 { display: grid; gap: 18px; list-style: none; margin: 0; padding: 0; }
  .row2 { grid-template-columns: 1fr 1fr; }
  .row3 { grid-template-columns: repeat(3, 1fr); }
  .row4 { grid-template-columns: repeat(4, 1fr); }
  .box { background: var(--bg); border-radius: 10px; padding: 20px 22px; }
  .box--line { background: #fff; border: 1px solid var(--border); }
  .muted { color: var(--text-muted) !important; font-size: 15px; }
  .numbered .n, .checks .n { font-family: var(--font-head); font-size: 26px; font-weight: 700; color: var(--accent-text); display: block; }
  .checks .n { display: inline; font-size: 22px; margin-right: 4px; }
  .checks { flex: 1; }
  .checks .box { font-size: 15.5px; line-height: 1.45; display: flex; flex-direction: column; gap: 8px; }
  .checks .basis { font-size: 13.5px; color: var(--text-muted); border-top: 1px solid var(--border); padding-top: 8px; margin-top: auto; }
  .pills { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .pills li { padding: 6px 12px; border-radius: 6px; border: 1px solid var(--border); color: var(--primary); font-weight: 500; }
  .stat__value { font-size: 30px; }
  .row-chart { display: grid; grid-template-columns: 760px 1fr; gap: 24px; align-items: start; }
  .row-chart img { width: 760px; border: 1px solid var(--border); border-radius: 8px; }
  .list, .flags { margin: 0; padding-left: 22px; display: flex; flex-direction: column; gap: 8px; color: var(--text-2); }
  .flags { gap: 6px; font-size: 16.5px; }
  .flags li::marker { color: var(--accent-text); font-weight: 700; }
  .body { font-size: 17px; }
  .dense { gap: 16px; font-size: 15.5px; line-height: 1.45; }
  .dense .box { padding: 16px 20px; }
</style>
