---
// Same card for every project: chart, type, one-line question, one key number, role, tools and its files.
import Icon from "./Icon.astro";
import { type Lang, text, pipes, card } from "../lib/content";
import { ui, caseHref, DOWNLOADS } from "../lib/ui";

interface Props { lang: Lang; block: string }
const { lang, block } = Astro.props;
const t = ui(lang);
const c = card(block, lang);
const tags = pipes(text(block, "tagline", lang));
const kind = tags[0].replace(/\s*\(.*\)$/, "");
const role = tags.at(-1)!.split(". ").find((x) => /role|Vai trò/i.test(x));
const question = text(block, "question", lang);
const title = text(block, "headline", lang);
const files = DOWNLOADS as Record<string, { href: string; name: string }>;
const excel = files[block];
const report = files[`${block}Report`];
---
<article class="pcard">
  <a class="pcard__media" href={caseHref(lang, block)} tabindex="-1" aria-hidden="true">
    {c.chart
      ? <img src={`/images/${c.chart}-${lang}.png`} alt="" width="1600" height="900" loading="lazy" />
      : <span class="pcard__big num">{c.value}</span>}
  </a>
  <div class="pcard__body">
    <p class="pcard__kind">{kind}</p>
    <h3 class="h3"><a href={caseHref(lang, block)}>{title}</a></h3>
    <p class="pcard__purpose">{question}</p>
    <p class="pcard__result"><span class="num">{c.value}</span> {c.label}</p>
    <ul class="pcard__meta">
      {role && <li>{role}</li>}
      <li>{t.tools}: {c.tools}</li>
    </ul>
    <div class="pcard__go">
      <a class="link-arrow" href={caseHref(lang, block)}>{t.readCase}<Icon name="arrow-right" size={16} /></a>
      {excel && <a class="link-arrow" href={excel.href} download={excel.name}><Icon name="download" size={16} />Excel</a>}
      {report && <a class="link-arrow" href={report.href} download={report.name}><Icon name="download" size={16} />PDF</a>}
    </div>
  </div>
</article>

<style>
  .pcard { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; display: flex; flex-direction: column; transition: border-color .2s ease, box-shadow .2s ease; }
  .pcard:hover { border-color: var(--primary); box-shadow: 0 6px 20px rgba(31,58,95,.10); }
  .pcard__media { display: flex; align-items: center; justify-content: center; aspect-ratio: 16 / 9; background: var(--bg); border-bottom: 1px solid var(--border); text-decoration: none; }
  .pcard__media img { width: 100%; height: 100%; object-fit: cover; }
  .pcard__big { font-family: var(--font-head); font-size: 64px; font-weight: 700; color: var(--primary); }
  .pcard__body { padding: 22px 24px 18px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .pcard__kind { font-size: 13px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--eyebrow); }
  .pcard h3 { font-size: 20px; }
  .pcard h3 a { text-decoration: none; color: var(--primary); }
  .pcard h3 a:hover { text-decoration: underline; }
  .pcard__result { font-size: 15px; color: var(--text-2); }
  .pcard__result .num { font-family: var(--font-head); font-size: 24px; font-weight: 700; color: var(--primary); margin-right: 4px; }
  .pcard__meta { list-style: none; margin: 0; padding: 0; font-size: 14px; color: var(--text-muted); display: flex; flex-direction: column; gap: 2px; }
  .pcard__go { margin-top: auto; display: flex; flex-wrap: wrap; gap: 4px 20px; }
  .pcard__purpose { font-size: 15px; color: var(--text-2); }
</style>
