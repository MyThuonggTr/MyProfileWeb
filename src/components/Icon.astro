---
// Small stroke icons (decorative; the text next to each one carries the meaning).
interface Props { name: "download" | "arrow-right" | "arrow-left" | "info" | "person"; size?: number }
const { name, size = 18 } = Astro.props;
---
<svg aria-hidden="true" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
  {name === "download" && <><path d="M12 3v12" /><path d="M7 10l5 5 5-5" /><path d="M5 21h14" /></>}
  {name === "arrow-right" && <><path d="M5 12h14" /><path d="M13 6l6 6-6 6" /></>}
  {name === "arrow-left" && <><path d="M19 12H5" /><path d="M11 6l-6 6 6 6" /></>}
  {name === "info" && <><circle cx="12" cy="12" r="9" /><path d="M12 8h.01" /><path d="M11 12h1v5h1" /></>}
  {name === "person" && <><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7" /></>}
</svg>
