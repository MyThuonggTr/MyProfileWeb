---
// "At a glance" box at the top of every case page: question, result, role, tools, date, and the project's own files (model and report).
import Icon from "./Icon.astro";
import { type Lang, text, raw, pipes, card } from "../lib/content";
import { ui, DOWNLOADS } from "../lib/ui";

interface Props { lang: Lang; block: string }
const { lang, block } = Astro.props;
const excel = (DOWNLOADS as Record<string, { href: string; name: string }>)[block];
const t = ui(lang);
const c = card(block, lang);
const tags = pipes(text(block, "tagline", lang));
const last = tags.at(-1)!.split(". ");
const role = last.find((x) => /role|Vai trò/i.test(x))?.replace(/^(My role|Role|Vai trò): /, "");
const when = last[0].match(/(\d{2}\/\d{4})/)?.[1] ?? last[0];
const report = (DOWNLOADS as Record<string, { href: string; name: string }>)[`${block}Report`];
const rows = [
  [t.question, text(block, "question", lang)],
  [t.result, `${c.value} ${c.label}`],
  ...(role ? [[t.role2, role]] : []),
  [t.tools, c.tools],
  [t.date, when],
];
---
<section class="glance" aria-label={t.summary}>
  <h2 class="glance__title">{t.summary}</h2>
  <dl>
    {rows.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
  </dl>
  <div class="btn-row">
    {excel && <a class="btn btn--solid" href={excel.href} download={excel.name}><Icon name="download" />{t.downloadExcel}</a>}
    {report && <a class="btn btn--line" href={report.href} download={report.name}><Icon name="download" />{t.reportLabel[block as keyof typeof t.reportLabel]}</a>}
  </div>
  <p class="glance__note">{raw("disclaimer", "text", lang)}</p>
</section>

<style>
  .glance { background: var(--bg); border: 1px solid var(--border); border-top: 3px solid var(--primary); border-radius: var(--radius); padding: 22px 24px; display: flex; flex-direction: column; gap: 16px; }
  .glance__title { font-family: var(--font-body); font-size: 13px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--eyebrow); }
  dl { margin: 0; display: grid; gap: 10px; }
  dl div { display: grid; grid-template-columns: 110px 1fr; gap: 12px; }
  dt { font-size: 14px; font-weight: 600; color: var(--text-muted); }
  dd { margin: 0; color: var(--text); }
  .glance__note { margin: 0; font-size: 14px; color: var(--text-muted); border-top: 1px solid var(--border); padding-top: 12px; }
  @media (max-width: 520px) { dl div { grid-template-columns: 1fr; gap: 2px; } }
</style>
